# NEEDBRIDGE Backend Environment Configuration

PROJECT_NAME=NEEDBRIDGE
SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: SQLite default for local zero-config, or PostgreSQL:
# postgresql://postgres:password@localhost:5432/needbridge
DATABASE_URL=sqlite:///./needbridge.db

# PayPal Sandbox Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI Model Configuration (Optional: fallback heuristic & vector matchers active by default)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
